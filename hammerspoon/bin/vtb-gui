#!/usr/bin/env bash
#
# vtb-gui - Claude Code integration for Hammerspoon GUI automation
#
# Single entry point for controlling the Vertebrae GUI via Hammerspoon.
# All commands return JSON and are designed for non-interactive use.
#
# Usage:
#   vtb-gui <command> [args...]
#   vtb-gui window list <app_name>
#   vtb-gui screenshot-app <app_name> [title]
#   vtb-gui click <x> <y>
#
# Requires: Hammerspoon with vtb.lua module loaded

set -euo pipefail

# Resolve the directory containing this script and the project root
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"

# JSON output helpers
json_error() {
    local msg="$1"
    local code="${2:-1}"
    printf '{"error":"%s"}\n' "$msg"
    exit "$code"
}

json_result() {
    printf '%s\n' "$1"
}

# Verify Hammerspoon CLI is available
require_hs() {
    if ! command -v hs &>/dev/null; then
        json_error "hs command not found. Install Hammerspoon and enable the CLI: https://www.hammerspoon.org"
    fi
}

# Run a Hammerspoon command and capture output.
# If hs fails (exit code != 0), return a JSON error.
# Filters out Hammerspoon's "-- Loading extension:" messages that appear
# on first use of an extension within a session.
run_hs() {
    local cmd="$1"
    local output
    local stderr_output
    local exit_code
    local stderr_file
    stderr_file="$(mktemp)"

    output="$(hs -c "$cmd" 2>"$stderr_file")" && exit_code=0 || exit_code=$?
    stderr_output="$(cat "$stderr_file")"
    rm -f "$stderr_file"

    if [ "$exit_code" -ne 0 ]; then
        local err_msg="$output $stderr_output"
        local escaped
        escaped="$(printf '%s' "$err_msg" | sed 's/"/\\"/g' | tr '\n' ' ')"
        json_error "hs command failed: $escaped"
    fi

    # Filter out Hammerspoon loading messages (e.g. "-- Loading extension: eventtap")
    # and extract only lines that look like JSON (start with { or [)
    local json_line
    json_line="$(printf '%s\n' "$output" | grep -E '^\s*[\{\[]' | tail -1)"

    if [ -z "$json_line" ]; then
        json_error "no JSON output from Hammerspoon command"
    fi

    json_result "$json_line"
}

# Escape a string for safe inclusion in a Lua string literal (single-quoted).
lua_escape() {
    local s="$1"
    # Escape backslashes first, then single quotes
    s="${s//\\/\\\\}"
    s="${s//\'/\\\'}"
    printf '%s' "$s"
}

# ---------------------------------------------------------------------------
# Subcommand: window
# ---------------------------------------------------------------------------
cmd_window() {
    local subcmd="${1:-}"
    shift || true

    case "$subcmd" in
        list)
            local app_name="${1:-}"
            [ -z "$app_name" ] && json_error "usage: vtb-gui window list <app_name>"
            run_hs "vtb.list_windows('$(lua_escape "$app_name")')"
            ;;
        find)
            local title="${1:-}"
            local app_name="${2:-}"
            [ -z "$title" ] || [ -z "$app_name" ] && json_error "usage: vtb-gui window find <title_substring> <app_name>"
            run_hs "vtb.find_window('$(lua_escape "$title")', '$(lua_escape "$app_name")')"
            ;;
        focus)
            local window_id="${1:-}"
            [ -z "$window_id" ] && json_error "usage: vtb-gui window focus <window_id>"
            run_hs "vtb.focus_window($window_id)"
            ;;
        focused)
            run_hs "vtb.focused_window()"
            ;;
        *)
            json_error "usage: vtb-gui window <list|find|focus|focused> [args...]"
            ;;
    esac
}

# ---------------------------------------------------------------------------
# Subcommand: click
# ---------------------------------------------------------------------------
cmd_click() {
    local x="${1:-}"
    local y="${2:-}"
    [ -z "$x" ] || [ -z "$y" ] && json_error "usage: vtb-gui click <x> <y>"
    run_hs "vtb.click_at($x, $y)"
}

# ---------------------------------------------------------------------------
# Subcommand: right-click
# ---------------------------------------------------------------------------
cmd_right_click() {
    local x="${1:-}"
    local y="${2:-}"
    [ -z "$x" ] || [ -z "$y" ] && json_error "usage: vtb-gui right-click <x> <y>"
    run_hs "vtb.right_click_at($x, $y)"
}

# ---------------------------------------------------------------------------
# Subcommand: type
# ---------------------------------------------------------------------------
cmd_type() {
    local text="${1:-}"
    [ -z "$text" ] && json_error "usage: vtb-gui type <text>"
    run_hs "vtb.type_text('$(lua_escape "$text")')"
}

# ---------------------------------------------------------------------------
# Subcommand: key-press
# ---------------------------------------------------------------------------
cmd_key_press() {
    local key="${1:-}"
    shift || true
    [ -z "$key" ] && json_error "usage: vtb-gui key-press <key> [modifier...]"

    # Build Lua modifiers table from remaining args
    local mods="{"
    local first=true
    for mod in "$@"; do
        if [ "$first" = true ]; then
            mods+="'$(lua_escape "$mod")'"
            first=false
        else
            mods+=",'$(lua_escape "$mod")'"
        fi
    done
    mods+="}"

    run_hs "vtb.key_press($mods, '$(lua_escape "$key")')"
}

# ---------------------------------------------------------------------------
# Subcommand: move-mouse
# ---------------------------------------------------------------------------
cmd_move_mouse() {
    local x="${1:-}"
    local y="${2:-}"
    [ -z "$x" ] || [ -z "$y" ] && json_error "usage: vtb-gui move-mouse <x> <y>"
    run_hs "vtb.move_mouse($x, $y)"
}

# ---------------------------------------------------------------------------
# Subcommand: mouse-position
# ---------------------------------------------------------------------------
cmd_mouse_position() {
    run_hs "vtb.mouse_position()"
}

# ---------------------------------------------------------------------------
# Subcommand: screenshot
# ---------------------------------------------------------------------------
cmd_screenshot() {
    run_hs "vtb.screenshot()"
}

# ---------------------------------------------------------------------------
# Subcommand: screenshot-window
# ---------------------------------------------------------------------------
cmd_screenshot_window() {
    local window_id="${1:-}"
    [ -z "$window_id" ] && json_error "usage: vtb-gui screenshot-window <window_id>"
    run_hs "vtb.screenshot_window($window_id)"
}

# ---------------------------------------------------------------------------
# Subcommand: screenshot-app
# ---------------------------------------------------------------------------
cmd_screenshot_app() {
    local app_name="${1:-}"
    local title="${2:-}"
    [ -z "$app_name" ] && json_error "usage: vtb-gui screenshot-app <app_name> [title_substring]"
    if [ -n "$title" ]; then
        run_hs "vtb.screenshot_app('$(lua_escape "$app_name")', '$(lua_escape "$title")')"
    else
        run_hs "vtb.screenshot_app('$(lua_escape "$app_name")')"
    fi
}

# ---------------------------------------------------------------------------
# Subcommand: screenshot-region
# ---------------------------------------------------------------------------
cmd_screenshot_region() {
    local source="${1:-}"
    local x="${2:-}"
    local y="${3:-}"
    local width="${4:-}"
    local height="${5:-}"

    [ -z "$source" ] || [ -z "$x" ] || [ -z "$y" ] || [ -z "$width" ] || [ -z "$height" ] && \
        json_error "usage: vtb-gui screenshot-region <source_png> <x> <y> <width> <height>"

    [ ! -f "$source" ] && json_error "source image not found: $source"

    local output
    output="$(mktemp /tmp/vtb-region-XXXXXX).png"

    local result
    result="$("$SCRIPT_DIR/vtb-img-diff" crop "$source" "$output" "$x" "$y" "$width" "$height" 2>&1)" || true

    # vtb-img-diff returns JSON; pass it through
    printf '%s\n' "$result"

    # Exit with error if the result contains an error field
    if printf '%s' "$result" | grep -q '"error"'; then
        rm -f "$output"
        exit 1
    fi
}

# ---------------------------------------------------------------------------
# Subcommand: screenshot-diff
# ---------------------------------------------------------------------------
cmd_screenshot_diff() {
    local before="${1:-}"
    local after="${2:-}"
    local diff_output="${3:-}"

    [ -z "$before" ] || [ -z "$after" ] && \
        json_error "usage: vtb-gui screenshot-diff <before_png> <after_png> [diff_output_png]"

    local diff_args=("diff" "$before" "$after")

    if [ -z "$diff_output" ]; then
        diff_output="$(mktemp /tmp/vtb-diff-XXXXXX).png"
    fi
    diff_args+=("--diff-output" "$diff_output")

    local result
    result="$("$SCRIPT_DIR/vtb-img-diff" "${diff_args[@]}" 2>&1)" || true

    printf '%s\n' "$result"

    if printf '%s' "$result" | grep -q '"error"'; then
        exit 1
    fi
}

# ---------------------------------------------------------------------------
# Subcommand: screenshot-pipeline
# ---------------------------------------------------------------------------
# Helper: extract a field from a JSON string using python
_json_field() {
    printf '%s' "$1" | python3 -c "import sys,json; print(json.load(sys.stdin)['$2'])" 2>/dev/null
}

cmd_screenshot_pipeline() {
    local app_name="${1:-}"
    local action="${2:-}"
    local title="${3:-}"
    local delay="${4:-1}"

    [ -z "$app_name" ] || [ -z "$action" ] && \
        json_error "usage: vtb-gui screenshot-pipeline <app_name> <action_command> [title] [delay_secs]"

    # Step 1: Capture "before" screenshot
    local before_json
    if [ -n "$title" ]; then
        before_json="$(run_hs "vtb.screenshot_app('$(lua_escape "$app_name")', '$(lua_escape "$title")')")" || exit $?
    else
        before_json="$(run_hs "vtb.screenshot_app('$(lua_escape "$app_name")')")" || exit $?
    fi

    if printf '%s' "$before_json" | grep -q '"error"'; then
        json_error "before screenshot failed"
    fi

    local before_path
    before_path="$(_json_field "$before_json" path)"
    [ -z "$before_path" ] && json_error "could not extract path from before screenshot"

    # Step 2: Execute the action (a vtb-gui subcommand string)
    local action_result
    action_result="$(eval "$SCRIPT_DIR/vtb-gui $action" 2>&1)" || true

    # Step 3: Wait for UI to settle
    sleep "$delay"

    # Step 4: Capture "after" screenshot
    local after_json
    if [ -n "$title" ]; then
        after_json="$(run_hs "vtb.screenshot_app('$(lua_escape "$app_name")', '$(lua_escape "$title")')")" || exit $?
    else
        after_json="$(run_hs "vtb.screenshot_app('$(lua_escape "$app_name")')")" || exit $?
    fi

    if printf '%s' "$after_json" | grep -q '"error"'; then
        json_error "after screenshot failed"
    fi

    local after_path
    after_path="$(_json_field "$after_json" path)"
    [ -z "$after_path" ] && json_error "could not extract path from after screenshot"

    # Step 5: Diff the before/after screenshots
    local diff_output
    diff_output="$(mktemp /tmp/vtb-pipeline-diff-XXXXXX).png"

    local diff_result
    diff_result="$("$SCRIPT_DIR/vtb-img-diff" diff "$before_path" "$after_path" --diff-output "$diff_output" 2>&1)" || true

    if printf '%s' "$diff_result" | grep -q '"error"'; then
        json_error "diff failed"
    fi

    local similarity
    similarity="$(_json_field "$diff_result" similarity)"

    # Build final JSON result using Python for safe serialization
    python3 -c "
import json, sys
result = {
    'success': True,
    'before': sys.argv[1],
    'after': sys.argv[2],
    'diff_image': sys.argv[3],
    'similarity': float(sys.argv[4]),
    'action': sys.argv[5],
    'changed': float(sys.argv[4]) < 1.0,
}
print(json.dumps(result))
" "$before_path" "$after_path" "$diff_output" "$similarity" "$action"
}

# ---------------------------------------------------------------------------
# Subcommand: ui-elements
# ---------------------------------------------------------------------------
cmd_ui_elements() {
    local window_id="${1:-}"
    local depth="${2:-3}"
    [ -z "$window_id" ] && json_error "usage: vtb-gui ui-elements <window_id> [depth]"
    run_hs "vtb.read_ui_elements($window_id, $depth)"
}

# ---------------------------------------------------------------------------
# Subcommand: ui-elements-app
# ---------------------------------------------------------------------------
cmd_ui_elements_app() {
    local app_name="${1:-}"
    local depth="${2:-3}"
    [ -z "$app_name" ] && json_error "usage: vtb-gui ui-elements-app <app_name> [depth]"
    run_hs "vtb.read_ui_elements_for_app('$(lua_escape "$app_name")', $depth)"
}

# ---------------------------------------------------------------------------
# Subcommand: launch
# ---------------------------------------------------------------------------
cmd_launch() {
    local app_name="${1:-Vertebrae}"
    local timeout="${2:-30}"
    local gui_dir="$PROJECT_ROOT/crates/gui"

    if [ ! -d "$gui_dir" ]; then
        json_error "GUI directory not found at $gui_dir"
    fi

    # Check if app is already running
    local windows
    windows="$(hs -c "vtb.list_windows('$(lua_escape "$app_name")')" 2>/dev/null)" || true

    if [ -n "$windows" ] && [ "$windows" != "[]" ]; then
        json_result "{\"success\":true,\"status\":\"already_running\",\"windows\":$windows}"
        return
    fi

    # Start tauri dev in background
    (cd "$gui_dir" && npm run tauri:dev &>/dev/null &)
    local dev_pid=$!

    # Wait for the window to appear
    local elapsed=0
    while [ "$elapsed" -lt "$timeout" ]; do
        sleep 2
        elapsed=$((elapsed + 2))

        windows="$(hs -c "vtb.list_windows('$(lua_escape "$app_name")')" 2>/dev/null)" || true
        if [ -n "$windows" ] && [ "$windows" != "[]" ]; then
            json_result "{\"success\":true,\"status\":\"launched\",\"elapsed_seconds\":$elapsed,\"windows\":$windows}"
            return
        fi
    done

    json_error "timeout waiting for $app_name window after ${timeout}s"
}

# ---------------------------------------------------------------------------
# Subcommand: wait-for-window
# ---------------------------------------------------------------------------
cmd_wait_for_window() {
    local app_name="${1:-Vertebrae}"
    local timeout="${2:-30}"

    local elapsed=0
    while [ "$elapsed" -lt "$timeout" ]; do
        local windows
        windows="$(hs -c "vtb.list_windows('$(lua_escape "$app_name")')" 2>/dev/null)" || true

        if [ -n "$windows" ] && [ "$windows" != "[]" ]; then
            json_result "{\"success\":true,\"elapsed_seconds\":$elapsed,\"windows\":$windows}"
            return
        fi

        sleep 2
        elapsed=$((elapsed + 2))
    done

    json_error "timeout waiting for $app_name window after ${timeout}s"
}

# ---------------------------------------------------------------------------
# Help
# ---------------------------------------------------------------------------
print_help() {
    cat <<'HELP'
vtb-gui - Claude Code integration for Hammerspoon GUI automation

Usage: vtb-gui <command> [args...]

Window Management:
  window list <app_name>                    List windows for an application
  window find <title> <app_name>            Find windows by title substring
  window focus <window_id>                  Focus a window by ID
  window focused                            Get the currently focused window

Mouse & Keyboard:
  click <x> <y>                             Left-click at coordinates
  right-click <x> <y>                       Right-click at coordinates
  type <text>                               Type text via simulated keystrokes
  key-press <key> [modifier...]             Press a key combination
  move-mouse <x> <y>                        Move mouse to coordinates
  mouse-position                            Get current mouse position

Screenshots:
  screenshot                                Full screen screenshot
  screenshot-window <window_id>             Screenshot a specific window
  screenshot-app <app_name> [title]         Screenshot by app (optional title filter)
  screenshot-region <src> <x> <y> <w> <h>   Crop a region from a screenshot PNG
  screenshot-diff <before> <after> [diff]   Compare two screenshots (similarity score + visual diff)
  screenshot-pipeline <app> <action> [t] [d]  Before/after pipeline (capture, act, capture, diff)

UI Inspection:
  ui-elements <window_id> [depth]           Read accessibility tree (default depth: 3)
  ui-elements-app <app_name> [depth]        Read accessibility tree by app name

App Lifecycle:
  launch [app_name] [timeout]               Start tauri:dev and wait for window
  wait-for-window [app_name] [timeout]      Wait for an app window to appear

All commands return JSON. Errors include an "error" field.
Screenshots return a "path" field with the absolute path to the PNG file.
Diff commands return a "similarity" field (0.0-1.0) and "diff_image" path.
HELP
}

# ---------------------------------------------------------------------------
# Main dispatch
# ---------------------------------------------------------------------------
main() {
    local cmd="${1:-}"
    shift || true

    # Check for help flags anywhere
    case "$cmd" in
        -h|--help|help|"")
            print_help
            exit 0
            ;;
    esac

    require_hs

    case "$cmd" in
        window)             cmd_window "$@" ;;
        click)              cmd_click "$@" ;;
        right-click)        cmd_right_click "$@" ;;
        type)               cmd_type "$@" ;;
        key-press)          cmd_key_press "$@" ;;
        move-mouse)         cmd_move_mouse "$@" ;;
        mouse-position)     cmd_mouse_position "$@" ;;
        screenshot)         cmd_screenshot ;;
        screenshot-window)  cmd_screenshot_window "$@" ;;
        screenshot-app)     cmd_screenshot_app "$@" ;;
        screenshot-region)  cmd_screenshot_region "$@" ;;
        screenshot-diff)    cmd_screenshot_diff "$@" ;;
        screenshot-pipeline) cmd_screenshot_pipeline "$@" ;;
        ui-elements)        cmd_ui_elements "$@" ;;
        ui-elements-app)    cmd_ui_elements_app "$@" ;;
        launch)             cmd_launch "$@" ;;
        wait-for-window)    cmd_wait_for_window "$@" ;;
        *)
            json_error "unknown command: $cmd. Run 'vtb-gui --help' for usage."
            ;;
    esac
}

main "$@"
