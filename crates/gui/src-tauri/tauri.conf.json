{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vertebrae",
  "version": "0.1.0",
  "identifier": "com.vertebrae.app",
  "build": {
    "beforeDevCommand": "npm run tauri:prepare-sidecars && npm run dev",
    "beforeBuildCommand": "npm run tauri:prepare-sidecars && npm run build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "windows": [
      {
        "title": "Vertebrae",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/vtb",
      "binaries/vtb-daemon"
    ]
  }
}
