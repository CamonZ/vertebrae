{
  "workflows": [
    {
      "workflow_ref": "build",
      "name": "Bñild ✨",
      "description": "Portable build pipeline",
      "display_order": 2,
      "is_default": true,
      "kanban_column": "in_progress",
      "factory_name": "release",
      "metadata": {
        "notes": "keep 00000000-0000-0000-0000-000000000099 unchanged",
        "nested": {
          "enabled": true,
          "labels": [
            "one",
            "two"
          ],
          "unicode": "café"
        }
      },
      "initial_step": {
        "workflow_ref": "build",
        "step_ref": "start"
      },
      "steps": [
        {
          "step_ref": "finish",
          "name": "Finish",
          "goal": "Close the build",
          "step_type": "finish",
          "step_order": 2,
          "config": null,
          "persistence_options": null
        },
        {
          "step_ref": "route",
          "name": "Route",
          "goal": "Choose the next workflow",
          "step_type": "route",
          "step_order": 1,
          "config": {
            "version": 1,
            "route_config": {
              "version": 1,
              "match_policy": "exactly_one",
              "rules": [
                {
                  "id": "approved",
                  "when": {
                    "ref": "previous_output.route.result",
                    "op": "eq",
                    "value": "approved"
                  },
                  "transition": {
                    "type": "intra_workflow",
                    "step_ref": "finish"
                  },
                  "handoff": {
                    "decision": "{{ previous_output.route.result }}"
                  }
                },
                {
                  "id": "review",
                  "when": {
                    "all": [
                      {
                        "ref": "task.tags",
                        "op": "contains",
                        "value": "review"
                      }
                    ]
                  },
                  "transition": {
                    "type": "inter_workflow",
                    "workflow_ref": "review"
                  },
                  "handoff": {
                    "source": "route"
                  }
                },
                {
                  "id": "pause",
                  "when": {
                    "all": [
                      {
                        "ref": "task.tags",
                        "op": "contains",
                        "value": "pause"
                      }
                    ]
                  },
                  "transition": {
                    "type": "intra_workflow",
                    "step_ref": "wait"
                  },
                  "handoff": {
                    "source": "route"
                  }
                }
              ],
              "default": {
                "transition": {
                  "type": "intra_workflow",
                  "step_ref": "wait"
                },
                "handoff": {}
              }
            }
          },
          "persistence_options": null
        },
        {
          "step_ref": "start",
          "name": "Start",
          "goal": "Start the build",
          "step_type": "llm_inference",
          "step_order": 0,
          "persistence_options": {
            "artifact": {
              "logical_name": "build-result"
            }
          },
          "config": {
            "version": 1,
            "prompt": "",
            "output_schema": {
              "type": "object",
              "required": [
                "ok"
              ],
              "properties": {
                "ok": {
                  "type": "boolean"
                }
              }
            },
            "agents": [
              "agent-a",
              "agent-b"
            ],
            "skills": [
              "build",
              "verify"
            ],
            "agent_config": {
              "provider": "openai",
              "allowed_tools": [
                "Read",
                "Write"
              ],
              "json_schema": {
                "type": "object",
                "properties": {
                  "ok": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        {
          "step_ref": "wait",
          "name": "Wait for Children",
          "goal": "Wait for child tasks",
          "step_type": "wait_children",
          "step_order": 3,
          "config": {
            "version": 1
          },
          "persistence_options": null
        },
        {
          "step_ref": "input",
          "name": "Human Approval",
          "goal": "Collect approval",
          "step_type": "human_input",
          "step_order": 4,
          "config": null,
          "persistence_options": null
        },
        {
          "step_ref": "pause",
          "name": "Pause Run",
          "goal": "Pause the current run",
          "step_type": "stop",
          "step_order": 5,
          "config": null,
          "persistence_options": null
        }
      ]
    },
    {
      "workflow_ref": "review",
      "name": "Review",
      "description": null,
      "display_order": 3,
      "kanban_column": "review",
      "metadata": {
        "owner": "qa"
      },
      "initial_step": {
        "workflow_ref": "review",
        "step_ref": "review"
      },
      "steps": [
        {
          "step_ref": "done",
          "name": "Done",
          "step_type": "finish",
          "step_order": 2,
          "config": null,
          "goal": null,
          "persistence_options": null
        },
        {
          "step_ref": "review",
          "name": "Review",
          "step_order": 0,
          "step_type": "llm_inference",
          "config": {
            "version": 1,
            "prompt": "Review output",
            "output_schema": {
              "type": "object"
            },
            "agents": [
              "reviewer"
            ],
            "skills": [
              "review"
            ]
          },
          "goal": null,
          "persistence_options": null
        },
        {
          "step_ref": "classify",
          "name": "Classify",
          "goal": "Classify the review outcome",
          "step_type": "structured_inference",
          "step_order": 1,
          "persistence_options": null,
          "config": {
            "version": 1,
            "provider": "typesafe",
            "model": "jev",
            "state": {
              "title": "{{ task.title }}"
            },
            "questions": {
              "approved": {
                "type": "noul",
                "instructions": "Is this approved?",
                "criteria": {
                  "true": "The review is approved",
                  "false": "The review is not approved"
                }
              }
            }
          }
        }
      ]
    }
  ],
  "step_edges": [
    {
      "from": {
        "workflow_ref": "build",
        "step_ref": "route"
      },
      "to": {
        "workflow_ref": "build",
        "step_ref": "finish"
      },
      "label": "approved"
    },
    {
      "from": {
        "workflow_ref": "build",
        "step_ref": "start"
      },
      "to": {
        "workflow_ref": "build",
        "step_ref": "route"
      },
      "label": "next"
    },
    {
      "from": {
        "workflow_ref": "build",
        "step_ref": "route"
      },
      "to": {
        "workflow_ref": "build",
        "step_ref": "wait"
      },
      "label": "pause"
    },
    {
      "from": {
        "workflow_ref": "build",
        "step_ref": "wait"
      },
      "to": {
        "workflow_ref": "build",
        "step_ref": "input"
      },
      "label": "children_done"
    },
    {
      "from": {
        "workflow_ref": "build",
        "step_ref": "input"
      },
      "to": {
        "workflow_ref": "build",
        "step_ref": "pause"
      },
      "label": "needs_pause"
    },
    {
      "from": {
        "workflow_ref": "build",
        "step_ref": "pause"
      },
      "to": {
        "workflow_ref": "build",
        "step_ref": "finish"
      },
      "label": "continue"
    },
    {
      "from": {
        "workflow_ref": "review",
        "step_ref": "done"
      },
      "to": {
        "workflow_ref": "review",
        "step_ref": "review"
      },
      "label": "retry"
    },
    {
      "from": {
        "workflow_ref": "review",
        "step_ref": "review"
      },
      "to": {
        "workflow_ref": "review",
        "step_ref": "classify"
      },
      "label": "complete"
    },
    {
      "from": {
        "workflow_ref": "review",
        "step_ref": "classify"
      },
      "to": {
        "workflow_ref": "review",
        "step_ref": "done"
      },
      "label": "classified"
    }
  ],
  "workflow_edges": [
    {
      "from_workflow_ref": "build",
      "to_workflow_ref": "review",
      "destination_step": {
        "workflow_ref": "review",
        "step_ref": "review"
      },
      "label": "needs_review"
    },
    {
      "from_workflow_ref": "review",
      "to_workflow_ref": "build",
      "destination_step": {
        "workflow_ref": "build",
        "step_ref": "start"
      },
      "label": "rebuild"
    }
  ]
}
