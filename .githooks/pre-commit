#!/bin/bash
# Pre-commit hook for vertebrae project
# Runs formatting, linting, testing, and coverage checks

set -e

echo "Running pre-commit checks..."

# Fast check first - fail early if formatting is wrong
echo "==> Checking Rust code formatting..."
cargo fmt --check

# Run independent checks in parallel
echo "==> Running clippy, coverage, GUI tests, and linting in parallel..."

# Start background jobs
cargo clippy --quiet -- -D warnings &
CLIPPY_PID=$!

cargo llvm-cov --quiet --fail-under-lines 75 &
LLVM_COV_PID=$!

(cd crates/gui && npm run test) &
GUI_PID=$!

(cd crates/gui && npm run lint) &
LINT_PID=$!

# Wait for all jobs and capture exit codes
CLIPPY_EXIT=0
LLVM_COV_EXIT=0
GUI_EXIT=0
LINT_EXIT=0

wait $CLIPPY_PID || CLIPPY_EXIT=$?
wait $LLVM_COV_PID || LLVM_COV_EXIT=$?
wait $GUI_PID || GUI_EXIT=$?
wait $LINT_PID || LINT_EXIT=$?

# Report failures
if [ $CLIPPY_EXIT -ne 0 ]; then
    echo "ERROR: clippy failed"
fi
if [ $LLVM_COV_EXIT -ne 0 ]; then
    echo "ERROR: tests or coverage failed"
fi
if [ $GUI_EXIT -ne 0 ]; then
    echo "ERROR: GUI tests failed"
fi
if [ $LINT_EXIT -ne 0 ]; then
    echo "ERROR: linting failed"
fi

# Exit with error if any failed
if [ $CLIPPY_EXIT -ne 0 ] || [ $LLVM_COV_EXIT -ne 0 ] || [ $GUI_EXIT -ne 0 ] || [ $LINT_EXIT -ne 0 ]; then
    exit 1
fi

echo "All pre-commit checks passed!"
