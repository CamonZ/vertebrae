#!/bin/bash
# Pre-commit hook for vertebrae project
# Runs formatting, linting, testing, and coverage checks

set -e

echo "Running pre-commit checks..."

# Fast check first - fail early if formatting is wrong
echo "==> Checking Rust code formatting..."
cargo fmt --check

# The gui crate declares vtb/vtb-daemon/vtb-gate as Tauri externalBin sidecars;
# Tauri's build script fails if those files are missing for the host triple.
# Stage them before any cargo command that compiles the gui crate.
echo "==> Staging Tauri sidecars..."
cargo build -p vertebrae-cli -p vertebrae-daemon -p vtb-gate --quiet
triple="$(rustc -vV | sed -n 's/^host: //p')"
mkdir -p crates/gui/src-tauri/binaries
cp "target/debug/vtb" "crates/gui/src-tauri/binaries/vtb-${triple}"
cp "target/debug/vtb-daemon" "crates/gui/src-tauri/binaries/vtb-daemon-${triple}"
cp "target/debug/vtb-gate" "crates/gui/src-tauri/binaries/vtb-gate-${triple}"

# Phase 1: Rust checks. Keep coverage isolated so concurrent cargo builds do
# not pollute the llvm-cov report with unexecuted binaries from other crates.
echo "==> Running clippy..."
cargo clippy --quiet --workspace --exclude acceptance --exclude gui-acceptance --exclude daemon-acceptance -- -D warnings

echo "==> Running tests with coverage..."
cargo llvm-cov --quiet --workspace --exclude gui --exclude acceptance --exclude gui-acceptance --exclude daemon-acceptance --ignore-filename-regex 'crates/gui/src-tauri/.*' --fail-under-lines 75

# Phase 2: GUI static checks in parallel, then the GUI test suite with a
# bounded worker pool. Running all three at once can starve Vitest workers on
# developer machines and turn otherwise passing tests into startup timeouts.
echo "==> Running GUI linting and type checking in parallel..."

(cd crates/gui && npm run lint) &
LINT_PID=$!

(cd crates/gui && npm run typecheck) &
TYPECHECK_PID=$!

LINT_EXIT=0
TYPECHECK_EXIT=0

wait $LINT_PID || LINT_EXIT=$?
wait $TYPECHECK_PID || TYPECHECK_EXIT=$?

if [ $LINT_EXIT -ne 0 ]; then
    echo "ERROR: linting failed"
fi
if [ $TYPECHECK_EXIT -ne 0 ]; then
    echo "ERROR: TypeScript type checking failed"
fi

if [ $LINT_EXIT -ne 0 ] || [ $TYPECHECK_EXIT -ne 0 ]; then
    exit 1
fi

echo "==> Running GUI tests..."
(cd crates/gui && npx vitest run --maxWorkers=2)

echo "All pre-commit checks passed!"
